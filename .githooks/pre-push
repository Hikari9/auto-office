#!/bin/bash
# Pre-push hook. Enable once per clone: git config core.hooksPath .githooks
# 1. PR guard: direct pushes to main are rejected (owner bypass: BYPASS_PR=1).
# 2. Validation gate: scripts/validate.sh --pr (CI stays empty, #120). Skipped for delete-only
#    pushes; skip explicitly with SKIP_VALIDATE=1.
protected_branch="main"
zero="0000000000000000000000000000000000000000"
updates=0

while read local_ref local_sha remote_ref remote_sha
do
  # A branch deletion ships no code, so it needs no validation.
  if [ "$local_sha" != "$zero" ]; then
    updates=$((updates + 1))
    pushed_sha="$local_sha"
  fi
  if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
    if [ "$BYPASS_PR" = "1" ]; then
      echo "⚠️ [PR GUARD] Direct push to main BYPASSED by repo owner."
    else
      echo "🚫 [PR GUARD REJECT] Direct push to main is protected."
      echo "Please open a Pull Request targeting main and get an approval from @rico-favor."
      echo "(Owner bypass override: BYPASS_PR=1 git push origin main)"
      exit 1
    fi
  fi
done

if [ "$updates" = "0" ]; then
  echo "[VALIDATE] Only branch deletions in this push; nothing to validate."
  exit 0
fi

if [ "$SKIP_VALIDATE" = "1" ]; then
  echo "⚠️ [VALIDATE] Skipped by SKIP_VALIDATE=1."
  exit 0
fi

# A push can update an explicit commit other than checkout HEAD. Only attest
# exactly HEAD; refuse unrelated pushed refs instead of validating wrong bytes.
if [ "$updates" -ne 1 ] || [ "$pushed_sha" != "$(git rev-parse HEAD)" ]; then
  echo "[PR GATE] Push must contain exactly the current HEAD; push branches individually." >&2
  exit 2
fi
exec "$(git rev-parse --show-toplevel)/scripts/validate.sh" --pr
