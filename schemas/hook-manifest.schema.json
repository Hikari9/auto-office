{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["installed_at", "hooks"],
  "properties": {
    "installed_at": {"type": "string"},
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "trigger", "script", "idempotent"],
        "properties": {
          "name": {"type": "string"},
          "trigger": {"enum": ["session_end", "pre_compact", "post_compact", "dispatch_complete", "cleanup", "stop"]},
          "script": {"type": "string"},
          "idempotent": {"type": "boolean"},
          "timeout": {"type": "integer"}
        }
      }
    }
  }
}
